{
  "name": "gestion-des-chants",
  "version": "1.0.0",
  "private": true,
  "description": "Assets front (SCSS + Bootstrap) pour la gestion des chants",
  "scripts": {
    "css": "sass public/assets/scss/app.scss public/assets/css/app.css --load-path=node_modules --style=compressed --no-source-map --quiet-deps --silence-deprecation=import,color-functions,global-builtin",
    "watch": "sass public/assets/scss/app.scss public/assets/css/app.css --load-path=node_modules --watch",
    "vendor": "node scripts/copy-vendor.js",
    "build": "npm run vendor && npm run css"
  },
  "devDependencies": {
    "bootstrap": "^5.3.3",
    "sass": "^1.77.0",
    "sortablejs": "^1.15.2"
  }
}
