<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Laisser passer les fichiers et dossiers existants (assets, uploads...)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tout le reste vers le contrôleur frontal
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# L'affichage des erreurs PHP est désactivé par le code (src/bootstrap.php) :
# elles sont journalisées mais jamais montrées à l'utilisateur.
# Pour les afficher en local, mettre 'debug' => true dans config.php['app'].
